{
  "info": {
    "name": "FreshCart API",
    "description": "Complete API collection for the FreshCart online grocery platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Test User\",\"email\":\"test@example.com\",\"password\":\"Password123!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const data = pm.response.json().data;", "pm.collectionVariables.set('accessToken', data.accessToken);", "pm.collectionVariables.set('refreshToken', data.refreshToken);"] } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Password123!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "const data = pm.response.json().data;", "pm.collectionVariables.set('accessToken', data.accessToken);"] } }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List Categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } },
        { "name": "List Products", "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&pageSize=20" } },
        { "name": "Search Products", "request": { "method": "GET", "url": "{{baseUrl}}/products?q=banana" } },
        { "name": "Featured Products", "request": { "method": "GET", "url": "{{baseUrl}}/products/featured" } },
        { "name": "Deals of the Day", "request": { "method": "GET", "url": "{{baseUrl}}/products/deals" } },
        { "name": "Product Detail", "request": { "method": "GET", "url": "{{baseUrl}}/products/fresh-bananas" } }
      ]
    },
    {
      "name": "Cart",
      "item": [
        { "name": "Get Cart", "request": { "method": "GET", "url": "{{baseUrl}}/cart", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Add Item", "request": { "method": "POST", "url": "{{baseUrl}}/cart/items", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\":\"PRODUCT_UUID\",\"quantity\":1}" } } },
        { "name": "Apply Coupon", "request": { "method": "POST", "url": "{{baseUrl}}/cart/coupon", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"code\":\"WELCOME10\"}" } } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        { "name": "Get Delivery Slots", "request": { "method": "GET", "url": "{{baseUrl}}/orders/delivery-slots", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } },
        { "name": "Place Order", "request": { "method": "POST", "url": "{{baseUrl}}/orders", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"addressId\":\"ADDRESS_UUID\",\"deliverySlotId\":\"SLOT_UUID\",\"paymentMethod\":\"cod\"}" } } },
        { "name": "Order History", "request": { "method": "GET", "url": "{{baseUrl}}/orders", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] } }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Services OK', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ok'); });"] } }] }
      ]
    }
  ]
}
