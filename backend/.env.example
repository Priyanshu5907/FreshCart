# =============================================================================
# Online Grocery Platform – Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=3001


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (Prisma DATABASE_URL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/grocery_db


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL used for caching, session store, and Socket.io adapter
# Format: redis://<host>:<port>  or  redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# JWT (JSON Web Tokens)
# -----------------------------------------------------------------------------

# Secret key for signing access tokens – must be at least 32 random characters
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# Separate secret for signing refresh tokens – must be at least 32 random characters
JWT_REFRESH_SECRET=change_me_to_another_random_string_of_at_least_32_chars

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRY=7d


# -----------------------------------------------------------------------------
# Bcrypt
# -----------------------------------------------------------------------------

# Number of salt rounds for bcrypt password hashing (higher = slower but safer)
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------

# OAuth 2.0 client credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must match the redirect URI registered in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback


# -----------------------------------------------------------------------------
# Facebook OAuth
# -----------------------------------------------------------------------------

# App credentials from Meta for Developers (developers.facebook.com)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Must match the redirect URI registered in the Facebook App Dashboard
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback


# -----------------------------------------------------------------------------
# Twilio (SMS / OTP)
# -----------------------------------------------------------------------------

# Account SID from the Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth token from the Twilio Console dashboard
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number used as the SMS sender (E.164 format)
TWILIO_PHONE_NUMBER=+1234567890


# -----------------------------------------------------------------------------
# Razorpay (Payment Gateway)
# -----------------------------------------------------------------------------

# API key ID from the Razorpay Dashboard (Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# API key secret from the Razorpay Dashboard – keep this confidential
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret set in the Razorpay Dashboard for signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# -----------------------------------------------------------------------------
# AWS (S3 + CloudFront)
# -----------------------------------------------------------------------------

# IAM user access key with S3 read/write permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# IAM user secret access key – keep this confidential
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS region where the S3 bucket is hosted (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# S3 bucket name for storing product images and other assets
AWS_S3_BUCKET=grocery-platform-assets

# CloudFront CDN base URL for serving assets (no trailing slash)
CLOUDFRONT_URL=https://your-distribution.cloudfront.net


# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Push Notifications)
# -----------------------------------------------------------------------------

# FCM server key from the Firebase Console (Project Settings → Cloud Messaging)
# Use this for legacy HTTP API; leave blank if using the Admin SDK below
FCM_SERVER_KEY=your_fcm_server_key

# Firebase Admin SDK service account JSON (stringified) for the Admin SDK approach
# Generate from Firebase Console → Project Settings → Service Accounts
# Leave blank if using FCM_SERVER_KEY above
FIREBASE_SERVICE_ACCOUNT_JSON=


# -----------------------------------------------------------------------------
# Web Push (VAPID Keys)
# -----------------------------------------------------------------------------

# VAPID public key for browser push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key

# VAPID private key – keep this confidential
VAPID_PRIVATE_KEY=your_vapid_private_key

# VAPID subject – a mailto: or https: URI identifying the push sender
VAPID_SUBJECT=mailto:admin@example.com


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Base URL of the Next.js frontend (used for CORS and OAuth redirect URIs)
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Email (SMTP / Nodemailer)
# -----------------------------------------------------------------------------

# SMTP server hostname (e.g. smtp.gmail.com, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.example.com

# SMTP port – 587 for STARTTLS, 465 for SSL, 25 for plain (not recommended)
SMTP_PORT=587

# SMTP authentication username (often the sender email address)
SMTP_USER=your_smtp_user@example.com

# SMTP authentication password or app-specific password
SMTP_PASS=your_smtp_password

# "From" address shown in outgoing emails (e.g. "Grocery Platform <no-reply@example.com>")
EMAIL_FROM=Grocery Platform <no-reply@example.com>


# -----------------------------------------------------------------------------
# Monitoring (Prometheus)
# -----------------------------------------------------------------------------

# Port on which the Prometheus /metrics endpoint is exposed
METRICS_PORT=9090
