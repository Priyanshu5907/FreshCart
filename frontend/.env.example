# =============================================================================
# Online Grocery Platform – Frontend Environment Variables (Next.js)
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Never commit the actual .env.local file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# API & WebSocket
# -----------------------------------------------------------------------------

# Base URL of the backend REST API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Base URL of the backend Socket.io server (no trailing slash)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001


# -----------------------------------------------------------------------------
# Razorpay (Payment Gateway)
# -----------------------------------------------------------------------------

# Razorpay publishable key ID – safe to expose in the browser
# Obtain from the Razorpay Dashboard (Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------

# VAPID public key for subscribing to browser push notifications
# Must match the VAPID_PUBLIC_KEY set on the backend
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key


# -----------------------------------------------------------------------------
# Firebase (FCM Web Push & Analytics)
# -----------------------------------------------------------------------------

# Firebase project API key – safe to expose in the browser
# Obtain from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key

# Firebase Auth domain for the project (e.g. your-project.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project ID (e.g. your-project-id)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Cloud Messaging sender ID (numeric, from Project Settings → Cloud Messaging)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase web app ID (from Project Settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
